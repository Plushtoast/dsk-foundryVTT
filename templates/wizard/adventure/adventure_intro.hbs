<div>
    <h1>{{localize 'dsk.Book.Wizard'}}</h1>
    <p>{{localize 'dsk.Book.Description'}}</p>   
    {{#if adventures}}
    <h2>{{localize 'dsk.Book.availableModules'}}</h2>    
    <ul class="dsklist">
        {{#each adventures as |item i|}}
        <li>
            <div class="row-section">
                <div class="col ninety">
                    <a data-type="adventures" data-action="loadBook">{{item.id}}</a>
                </div>
                <div class="col ten">
                    {{#if ../isGM}}<a data-tooltip="dsk.Book.playerVisibility" data-action="toggleVisibility" data-type="adventures" data-itemid="{{item.id}}"><i class="fas {{#if item.visible}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i></a>{{/if}}
                </div>
            </div>
        </li>
        {{/each}}
    </ul>
    {{/if}}
    <h2>{{localize 'dsk.Book.availableRules'}}</h2>
    <ul class="dsklist">
        {{#if rules}} {{#each rules as |item i|}}
        <li>
            <div class="row-section">
                <div class="col ninety">
                    <a data-type="books" data-action="loadBook">{{item.id}}</a>
                </div>
                <div class="col ten">
                    {{#if ../isGM}}<a data-tooltip="dsk.Book.playerVisibility" data-action="toggleVisibility" data-type="books" data-itemid="{{item.id}}"><i class="fas {{#if item.visible}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i></a>{{/if}}
                </div>
            </div>
        </li>
        {{/each}} {{else}}
        <li>{{localize 'dsk.Book.nothing'}}</li>
        {{/if}}
    </ul>
    {{#if rshs}}
    <h2>{{localize 'dsk.Book.availableRSHs'}}</h2>
    <ul class="dsklist">
         {{#each rshs as |item i|}}
        <li>
            <div class="row-section">
                <div class="col ninety">
                    <a data-type="rshs" data-action="loadBook">{{item.id}}</a>
                </div>
                <div class="col ten">
                    {{#if ../isGM}}<a data-tooltip="dsk.Book.playerVisibility" data-action="toggleVisibility" data-type="rshs" data-itemid="{{item.id}}"><i class="fas {{#if item.visible}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i></a>{{/if}}
                </div>

            </div>
        </li>
        {{/each}} 
    </ul>
    {{/if}}
</div>