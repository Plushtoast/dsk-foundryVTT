<div class="scrollable">
    <section class="content" data-cost="0">
        <h1>{{title}}</h1>
        <p style="margin-bottom:10px;">{{{description}}}</p>

        {{> systems/dsk/templates/system/dsktabs.hbs}}

        <div class="tab {{tabs.description.cssClass}}" data-tab="description" data-group="{{tabs.description.group}}">
            <div class="row-section">
                <div class="col two">
                    {{{culture.system.description.value}}}
                </div>
                <div class="col two">
                    <img src="{{culture.img}}" style="max-width:100%; max-height: 100%;float: left;" data-edit="img" />
                </div>
            </div>
        </div>

        {{#if vantagesToChose}}
        <div class="tab {{tabs.vantages.cssClass}}" data-tab="vantages" data-group="{{tabs.vantages.group}}">
        <p>{{localize 'WIZARD.vantageDescriptionCulture'}}</p>
        {{#if advantagesToChose}}
        <h2>{{localize 'recommendedAdvantages'}}</h2>
        <div class="row-section wrap">
            {{#each advantages as |item i|}}
            <div class="col two row-section lineheight">
                <input type="checkbox" id="advantage_{{i}}" class="optional" data-cost="{{item.apCost}}" name="{{item.replaceName}}" data-step="{{item.step}}" value="{{item.uuid}}" checked {{#if item.disabled}}disabled{{/if}}>
                <label for="advantage_{{i}}">{{item.replaceName}} {{roman item.step}} ({{item.apCost}} AP)</label>
                <a class="show-item" data-action="showItem" data-id="{{item.uuid}}" data-tooltip="{{item.tooltip}}"><i class="fas fa-info"></i></a>
            </div>
            {{/each}}
        </div>
        {{/if}} {{#if disadvantagesToChose}}
        <h2>{{localize 'recommendedDisadvantages'}}</h2>
        <div class="row-section wrap">
            {{#each disadvantages as |item i|}}
            <div class="col two row-section lineheight">
                <input type="checkbox" id="disadvantage_{{i}}" class="optional" data-cost="{{item.apCost}}" name="{{item.replaceName}}" data-step="{{item.step}}" value="{{item.uuid}}" checked {{#if item.disabled}}disabled{{/if}}>
                <label for="disadvantage_{{i}}">{{item.replaceName}} {{roman item.step}} ({{item.apCost}} AP)</label>
                <a class="show-item" data-action="showItem" data-id="{{item.uuid}}" data-tooltip="{{item.tooltip}}"><i class="fas fa-info"></i></a>
            </div>
            {{/each}}
        </div>
        {{/if}}
    </div>
    {{/if}}
    {{#if generalToChose}}
    <div class="tab {{tabs.general.cssClass}}" data-tab="general" data-group="{{tabs.general.group}}">
        <h2>{{localize 'dsk.LocalizedIDs.localKnowledge'}}</h2>
        <p>{{localize 'WIZARD.localKnowledgeDescr'}}</p>
        <div class="row-section">
            <div class="col">
                <input type="text" class="localKnowledge" placeholder="{{culture.system.localKnowledge.value}}" />
            </div>
        </div>
        {{#if languagesToChose}}
        <h2>{{localize 'language'}}</h2>
        <p class="allowedCount_1" data-count="1">{{localize 'WIZARD.chose'}} 1.</p>
        <div class="row-section wrap">
            {{#each languages as |item i|}}
            <div class="col two row-section lineheight">
                <input type="checkbox" id="language_{{i}}" class="optional exclusive exclusive_1" data-cost="0" data-free="true" name="{{item.replaceName}}" data-step="{{item.step}}" value="{{item.uuid}}" {{#unless ../languagesToSelect}}disabled checked{{/unless}}>
                <label for="language_{{i}}">{{item.replaceName}} {{roman item.step}}</label>
                <a class="show-item" data-action="showItem" data-id="{{item.uuid}}" data-tooltip="{{item.tooltip}}"><i class="fas fa-info"></i></a>
            </div>
            {{/each}}
        </div>
        {{/if}} {{#if writingsToChose}}
        <h2>{{localize 'writing'}}</h2>
        <div class="row-section wrap">
            {{#each writings as |item i|}}
            <div class="col two row-section lineheight">
                <input type="checkbox" id="writing_{{i}}" class="optional" data-cost="{{item.apCost}}" name="{{item.replaceName}}" data-step="{{item.step}}" value="{{item.uuid}}" {{#if item.disabled}}disabled{{/if}}>
                <label for="writing_{{i}}">{{item.replaceName}} {{roman item.step}} ({{item.apCost}} AP)</label>
                <a class="show-item" data-action="showItem" data-id="{{item.uuid}}" data-tooltip="{{item.tooltip}}"><i class="fas fa-info"></i></a>
            </div>
            {{/each}}
        </div>
        {{/if}}
    </div>
        {{/if}}


        </section>
        <div class="dialog-buttons flexrow">
                <button class="dialog-button ok default" data-action="ok">
                <i class="fas fa-check"></i>
                {{localize 'dsk.ok'}}
            </button>
                <button class="dialog-button cancel default" data-action="cancel">
                <i class="fas fa-close"></i>
                {{localize 'dsk.cancel'}}
            </button>
        </div>
</div>