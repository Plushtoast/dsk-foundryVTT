<form class="characteristic-test">
    <div class="flexcol gap0px">
        <div class="form-group">
            <label>{{localize 'dsk.attributes'}}</label>
            <div class="form-fields">
                {{#each characteristics as |item i|}}
                <div class="col center" style="max-width: 50%;" data-tooltip="{{attrLoc item 'name'}}">
                    <select class="noAppearance" name="characteristics{{i}}">
                        {{selectOptions ../attributesList selected=item}}
                    </select>
                </div>
                {{/each}}
            </div>
        </div>
        {{> systems/dsk/templates/dialog/default-dialog.hbs}}

        <div class="roll-dialog-tag">characteristic</div>
    </div>
</form>