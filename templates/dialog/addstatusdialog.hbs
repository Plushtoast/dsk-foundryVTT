<div class="selection">

    <div class="row-section skills searchbox">
        <div class="col third lineheight">
            <b>{{localize "dsk.CONDITION.add"}}</b>
        </div>
        <div class="col third"></div>
        <div class="col third row-section lineheight">
            <div class="col ten center">
                <i class="fas fa-search"></i>
            </div>
            <div class="col eighty">
                <input type="search" data-dtype="String" class="conditionSearch" placeholder="{{localize 'dsk.Library.search'}}" />
            </div>
        </div>
    </div>
    <div class="row-section wrap statusEffect">
        {{#each effects as |itm i|}}
        <div class="col third filterable">
            <button data-action="reactClick" class="reactClick" data-value="{{itm.id}}" data-tooltip="{{itm.description}}"><img src="{{itm.icon}}" /><span>{{itm.name}}</span></button>
        </div>
        {{/each}}
    </div>
</div>