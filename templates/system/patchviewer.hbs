<div class="patchviewer" style="padding:20px">
    <div class="row-section table-title">
        <div class="col eighty">
            <h1 style="border:none;text-decoration:none;line-height:90px">{{{patchName}}}</h1>
        </div>
        <div class="col five">
            <img style="margin:0;float:right;height:90px" src="systems/dsk/lazy/patchimages/UlissesDigital.png" />
        </div>
    </div>

    <nav class="sheet-tabs tabs" data-group="sheet">
        <a class="item active" data-tab="newcontent" data-group="sheet">News</a>
        <a class="item" data-tab="changelog" data-group="sheet">Changelog</a>
        <a class="item" data-tab="content" data-group="sheet">{{localize 'dsk.modules'}}</a>
    </nav>
    <section class="content">
        <div class="tab newcontent active" data-tab="newcontent" data-group="sheet">
            {{{news}}} {{#each prevNews as |item i|}}
            <hr style="margin-top:100px" /> {{{item}}} {{/each}}
        </div>
        <div class="tab changelog" data-tab="changelog" data-group="sheet">
            {{{changelog}}} {{#each prevChangeLogs as |item i|}}
            <hr style="margin-top:100px" /> {{{item}}} {{/each}}
        </div>
        <div class="tab content" data-tab="content" data-group="sheet">
            {{{modules}}}
        </div>
    </section>
</div>