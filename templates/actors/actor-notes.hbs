<div class="groupbox">
    <div class="row-section header-label">
        <div class="col  lineheight">
            <b>{{localize "dsk.details"}}</b>
        </div>
    </div>
    <div class="row-section">
        <section class="general col">
            <div class="row-section wrap">
                <div class="col row-section">
                    <div class="headerInput col four">
                        {{formInput systemFields.details.fields.gender value=document.system.details.gender placeholder=(localize 'dsk.Gender') classes="input gender"}}
                        <span class="label gender">{{localize "dsk.Gender"}}</span>
                    </div>

                    <div class="headerInput col four">
                        {{formInput systemFields.details.fields.culture value=document.system.details.culture placeholder=(localize 'TYPES.Item.culture') classes="input-details"}}
                        <span class="label-details">{{localize "TYPES.Item.culture"}}</span>
                    </div>
                    <div class="headerInput col four">
                        {{formInput systemFields.details.fields.pack value=document.system.details.pack placeholder=(localize 'dsk.pack') classes="input-details"}}
                        <span class="label-details">{{localize "dsk.pack"}}</span>
                    </div>

                    <div class="headerInput col four">
                        {{formInput systemFields.details.fields.age value=document.system.details.age placeholder=(localize 'dsk.Age') classes="input-details"}}
                        <span class="label-details">{{localize "dsk.Age"}}<span>
                    </div>
                </div>

            </div>

        </section>
    </div>
</div>

{{> systems/dsk/templates/actors/parts/information.hbs}}

<div class="groupbox">
    <div class="row-section header-label">
        <div class="col ninety lineheight">
            <b>{{localize "dsk.biography"}}</b>
        </div>
        <div class="col lineheight ten">
            <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up" data-tooltip="dsk.SHEET.collapse"></i></a>
        </div>
    </div>
    <div class="row-section">
        <div class="col notes-box">
            {{formInput systemFields.notes.fields.biography value=document.system.notes.biography toggled=true enriched=enrichedBiography}}
        </div>
    </div>
</div>
<div class="groupbox">
    <div class="row-section header-label">
