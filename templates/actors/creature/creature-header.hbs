<div>
    <div class="flexrow wrap">
        <div class="flexgrow-0">
            {{> 'systems/dsk/templates/actors/actorv2/avatar.hbs'}}
        </div>
        <div>
            <header class="sheet-header flexrow lock{{prepare.sheetLocked}}">
                <div class="headerInput">
                    {{formInput fields.name value=document.name placeholder=(localize 'dsk.name') classes="input name"}}
                    <a class="actorDrag" data-tooltip="dsk.TT.dragLink"><i class="fas fa-link"></i></a>
                    <span class="label name">{{localize "dsk.name"}}</span>
                </div>
                <div class="headerInput">
                    <input class="input creatureClass" data-dtype="String" name="system.details.species" type="text" value="{{actor.system.details.species}}" placeholder="{{localize 'dsk.typus'}}" />
                    <span class="label creatureClass ">{{localize "dsk.typus"}}</span>
                </div>
            </header>
            {{> 'systems/dsk/templates/actors/parts/rollhead.hbs'}}
            {{> 'systems/dsk/templates/actors/parts/healthbar.hbs'}}
        </div>        
    </div>
</div>
