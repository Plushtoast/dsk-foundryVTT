<div class="tab scrollable gap0px magic {{tab.cssClass}}" data-tab="magic" data-group="{{tab.group}}">
<div class="groupbox">
    <div class="row-section wrap inverseRowtable">
        <div class="col">
            <div class="row-section skills table-title">
                <div class="col four">
                    {{localize "TYPES.Item.ahnengabe"}}
                </div>
                <div class="col four center">{{localize "dsk.probe"}}</div>
                <div class="col ten center" data-tooltip="dsk.FW">{{localize "dsk.CHARAbbrev.FW"}}</div>
                <div class="col ten center" data-tooltip="dsk.PW">{{localize "dsk.CHARAbbrev.PW"}}</div>
                <div class="col ten center" data-tooltip="dsk.AeP">{{localize "dsk.CHARAbbrev.AeP"}}</div>
                <div class="col ten center">{{localize "dsk.range"}}</div>
                <div class="col ten center">
                    <a data-action="itemCreate" class="item-create very-small" data-tooltip="dsk.SHEET.addItem" item-section="ahnengabe" data-type="ahnengabe"><i class="fas fa-plus"></i></a>
                </div>
            </div>
        </div>
        {{#each prepare.magic.ahnengabe as |item i|}}
        <div class="col spells item" data-item-id="{{item._id}}">
            <div class="row-section skills lineheight">
                <div class="col four">
                    <a data-action="itemEdit">{{item.name}}</a> {{#if item.canAdvance}}
                    <a data-action="advanceWrapper" data-fct="_refundItemAdvance" data-attr="{{item._id}}" class="advance refund-item"><i data-tooltip="{{item.refund}}" class="fas fa-minus"></i></a>
                    <a data-action="advanceWrapper" data-fct="_advanceItem" data-attr="{{item._id}}" class="advance advance-item"><i data-tooltip="{{item.cost}}" class="fas fa-plus"></i></a>{{/if}}
                </div>
                <div class="col four center">
                    <a data-action="spellSelect" class="spell-select">
                        <span class="d20 diet-{{item.system.characteristic1}}">{{attrLoc item.system.characteristic1 "abbr"}}</span>
                        <span class="d20 diet-{{item.system.characteristic2}}">{{attrLoc item.system.characteristic2 "abbr"}}</span>
                    </a>
                </div>
                <div class="col ten center">
                    <input class="skill-advances" type="text" data-dtype="Number" value="{{item.system.level}}" />
                </div>
                <div class="col ten center">
                    {{item.PW}}
                </div>
                <div class="col ten center">
                    {{item.system.AeP}}
                </div>
                
                <div class="col ten center">
                    {{item.system.range}}
                </div>

                <div class="col ten very-small center">
                    <a data-action="itemPost" class="item-post" data-tooltip="dsk.SHEET.PostItem"><i class="fas fa-comment"></i></a>
                    <a data-action="itemDropdown" class="item-dropdown" data-tooltip="dsk.SHEET.Dropdown"><i class="fas fa-chevron-down"></i></a>
                    <a data-action="deleteItem" class="item-control item-delete" data-tooltip="dsk.SHEET.DeleteItem"><i class="fas fa-trash"></i></a> 
                </div>
            </div>
            <div class="row-section lineheight expandDetails {{item.detailed}}">
                <div class="col">
                    <ul>
                        <li><b>{{localize "dsk.duration"}}</b>: {{item.system.duration}}</li>
                    </ul>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
</div>

<div class="groupbox">
    <div class="row-section">
        <div class="col header-label lineheight">
            <b>{{localize "dsk.SPECIALABILITYNAMES.ahnen"}}</b>
        </div>
    </div>
    <div class="row-section wrap cards">
        {{#each prepare.specAbs.ahnen as |item i|}}
        <div class="item" data-item-id="{{item._id}}">
            {{#if item.OnUseEffect}}<a data-action="onUseItem" data-tooltip="dsk.SHEET.onUseEffect" class="onUseItem"><i class="fas fa-dice-six"></i></a>{{/if}}<a data-action="itemEdit">{{item.name}}{{roman item.system.level item.system.max}}</a>
        </div>
        {{/each}}
    </div>
</div>

<div class="row-section">

    <div class="col ">
        <div class="groupbox">
            <div class="row-section">
                <div class="col header-label lineheight">
                    <b>{{localize "TYPES.Item.ahnengeschenk"}}</b>
                </div>
            </div>
            <div class="row-section wrap cards">
                {{#each prepare.magic.ahnengeschenk as |item i|}}
                <div class="item" data-item-id="{{item._id}}">
                    <a data-action="itemEdit">{{item.name}}</a>
                </div>
                {{/each}}
            </div>
        </div>
    </div>
</div>
</div>