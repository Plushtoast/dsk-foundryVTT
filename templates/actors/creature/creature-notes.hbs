        </div>
    </div>
    <div class="row-section">
        <div class="col notes-box">
            {{formInput systemFields.notes.fields.specialRules value=document.system.notes.specialRules toggled=true enriched=enrichedSpecialrules}}
        </div>
    </div>
</div>
{{#if actor.isOwner}}
<div class="groupbox">
    <div class="row-section header-label">
        <div class="col ninety lineheight">
            <b>{{localize "dsk.ownerNotes"}}</b>
