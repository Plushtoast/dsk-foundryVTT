<div class="tab scrollable gap0px notes {{tab.cssClass}}" data-tab="notes" data-group="{{tab.group}}">
{{> systems/dsk/templates/actors/parts/information.hbs}}

<div class="groupbox">
    <legend class="table-title lineheight">{{localize "dsk.description"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up" data-tooltip="dsk.SHEET.collapse"></i></a></legend>
    <div class="row-section">
        <div class="col notes-box">
            {{formInput systemFields.notes.fields.description value=document.system.notes.description toggled=true enriched=enrichedNotes}}
        </div>
    </div>
</div>
<div class="groupbox">
    <legend class="table-title lineheight">{{localize "dsk.fight"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up" data-tooltip="dsk.SHEET.collapse"></i></a></legend>
    <div class="row-section">
        <div class="col notes-box">
            {{formInput systemFields.notes.fields.fight value=document.system.notes.fight toggled=true enriched=enrichedBehaviour}}
        </div>
    </div>
</div>
<div class="groupbox">
    <legend class="table-title lineheight">{{localize "dsk.specialRules"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up" data-tooltip="dsk.SHEET.collapse"></i></a></legend>
    <div class="row-section">
        <div class="col notes-box">
            {{formInput systemFields.notes.fields.specialRules value=document.system.notes.specialRules toggled=true enriched=enrichedSpecialrules}}
        </div>
    </div>
</div>
{{#if actor.isOwner}}
<div class="groupbox">
    <legend class="table-title lineheight">{{localize "dsk.ownerNotes"}} <a data-action="chCollapse" class="ch-collapse"><i class="fas fa-angle-up" data-tooltip="dsk.SHEET.collapse"></i></a></legend>
    <div class="row-section">
        <div class="col notes-box">
            {{formInput systemFields.notes.fields.owner value=document.system.notes.owner toggled=true enriched=enrichedOwnerdescription}}
        </div>
    </div>
</div>
{{/if}}
</div>