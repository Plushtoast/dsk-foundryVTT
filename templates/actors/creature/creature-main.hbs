<div class="tab scrollable gap0px main {{tab.cssClass}}" data-tab="main" data-group="{{tab.group}}">
{{#if prepare.canAdvance}} {{> systems/dsk/templates/actors/parts/characteristics-large.hbs}} {{else}} {{> systems/dsk/templates/actors/parts/characteristics-small.hbs}} {{/if}}

<div class="main-row">
    <div class="column1">
        <div class="groupbox">
            <div class="advantages row-section">
                <div class="col header-label lineheight">
                    <b>{{localize "TYPES.Item.advantage"}}</b>
                </div>
            </div>
            <div class="row-section wrap cards">
                {{#each prepare.advantages as |item i|}}
                <div class="item" data-item-id="{{item._id}}">
                    <a data-action="itemEdit">{{item.name}}{{roman item.system.level item.system.max}}</a>
                </div>
                {{/each}}
            </div>
        </div>

        <div class="groupbox">
            <div class="disadvantages row-section">
                <div class="col header-label lineheight">
                    <b>{{localize "TYPES.Item.disadvantage"}}</b>
                </div>
            </div>
            <div class="row-section wrap cards">
                {{#each prepare.disadvantages as |item i|}}
                <div class="item" data-item-id="{{item._id}}">
                    <a data-action="itemEdit">{{item.name}}{{roman item.system.level item.system.max}}</a>
                </div>
                {{/each}}
            </div>
        </div>

        <div class="groupbox">
            <div class="generalSpecialAbilities row-section">
                <div class="col header-label lineheight">
                    <b>{{localize "dsk.SPECIALABILITYNAMES.general"}}</b>
                </div>
            </div>
            <div class="row-section wrap cards">
                {{#each prepare.specAbs.general as |item i|}}
                <div class="item" data-item-id="{{item._id}}">
                    {{#if item.OnUseEffect}}<a data-action="onUseItem" data-tooltip="dsk.SHEET.onUseEffect" class="onUseItem"><i class="fas fa-dice-six"></i></a>{{/if}}<a data-action="itemEdit">{{item.name}}{{roman item.system.level item.system.max}}</a>
                </div>
                {{/each}}
            </div>
        </div>

        <div class="groupbox">
            <div class="generalSpecialAbilities row-section">
                <div class="col header-label lineheight">
                    <b>{{localize "dsk.SPECIALABILITYCATEGORIES.language"}}</b>
                </div>
            </div>
            <div class="row-section wrap cards">
                {{#each prepare.specAbs.language as |item i|}}
                <div class="item" data-item-id="{{item._id}}">
                    {{#if item.OnUseEffect}}<a data-action="onUseItem" data-tooltip="dsk.SHEET.onUseEffect" class="onUseItem"><i class="fas fa-dice-six"></i></a>{{/if}}<a data-action="itemEdit">{{item.name}}{{roman item.system.level item.system.max}}</a>
                </div>
                {{/each}}
            </div>
        </div>

        <div class="groupbox">
            <div class="generalSpecialAbilities row-section">
                <div class="col header-label lineheight">
                    <b>{{localize "TYPES.Item.trait"}}</b>
                    <a data-action="itemCreate" class="item-create very-small" data-tooltip="dsk.SHEET.addItem" item-section="trait" data-type="trait"><i class="fas fa-plus"></i></a>
                </div>
            </div>
            <div class="row-section wrap cards">
                {{#each prepare.traits as |trait i|}} {{#each trait as |item i|}}
                <div class="item" data-item-id="{{item._id}}">
                    <a data-action="itemEdit">{{item.name}}</a>
                </div>
                {{/each}} {{/each}}

            </div>
        </div>
    </div>

    <div class="column2">
        <div class="groupbox" id="derivedAttrs">
            <div class="derivedAttrs row-section">
                <div class="col two">
                </div>
                <div class="col eight very-small center" data-tooltip="dsk.value">
                    {{localize "dsk.ABBR.value"}}
                </div>
                <div class="col eight very-small center" data-tooltip="dsk.Modifiers">
                    {{localize "dsk.ABBR.modifiers"}}
                </div>
                <div class="col eight very-small center" data-tooltip="dsk.Advances">
                    {{localize "dsk.ABBR.advances"}}
                </div>
                <div class="col eight very-small center" data-tooltip="dsk.ABBR.max">
                    {{localize "dsk.ABBR.max"}}
                </div>
            </div>
            <div class="derivedAttrs row-section">
                <div class="col two lineheight">
                    {{localize "dsk.LeP"}} {{#if prepare.canAdvance}}<a data-attr="LeP" data-action="advanceWrapper" data-fct="_refundPointsAdvance" class="advance"><i data-tooltip="{{actor.system.stats.LeP.refund}}" class="fas fa-minus"></i></a>
                    <a data-attr="LeP" data-action="advanceWrapper" data-fct="_advancePoints" class="advance"><i data-tooltip="{{actor.system.stats.LeP.cost}}" class="fas fa-plus"></i></a>{{/if}}
                    <span class="buttons">
                        <a data-char="regenerate" data-action="chRegenerate" class="ch-regenerate item" data-mod="regenerate" data-tooltip="dsk.regenerate">&nbsp;<i class="fas fa-moon"></i></a>
                    </span>
                </div>
                <div class="col eight lineheight center">
                    {{formInput systemFields.stats.fields.LeP.fields.initial value=actor.system.stats.LeP.initial}}
                </div>
                <div class="col eight center">
                    {{formInput systemFields.stats.fields.LeP.fields.modifier value=actor.system.stats.LeP.modifier}}
                </div>
                <div class="col eight center">
                    {{formInput systemFields.stats.fields.LeP.fields.advances value=actor.system.stats.LeP.advances}}
                </div>
                <div class="col eight lineheight center">
                    {{actor.system.stats.LeP.max}}
                </div>
            </div>
            
            <div class="derivedAttrs row-section">
                <div class="col two lineheight">
                    {{localize "dsk.CHARAbbrev.LeP"}} {{localize 'dsk.regenerate'}}
                </div>
                <div class="col eight lineheight center">

                </div>
                <div class="col eight center inputTooltipAvailable" data-tooltip="dsk.SHEET.permRegeneration">
                    {{formInput systemFields.stats.fields.regeneration.fields.LePMod value=actor.system.stats.regeneration.LePMod}}
                </div>
                <div class="col eight center inputTooltipAvailable" data-tooltip="dsk.SHEET.tempRegeneration">
                    {{formInput systemFields.stats.fields.regeneration.fields.LePTemp value=actor.system.stats.regeneration.LePTemp}}
                </div>
                <div class="col eight lineheight center">
                    {{actor.system.stats.regeneration.LePmax}}
                </div>
            </div>
           
            {{#if prepare.magic.hasSpells}}
            <div class="derivedAttrs row-section">
                <div class="col two lineheight">
                    {{localize "dsk.AeP"}} {{#if prepare.canAdvance}}<a data-attr="AeP" data-action="advanceWrapper" data-fct="_refundPointsAdvance" class="advance"><i data-tooltip="{{actor.system.stats.AeP.refund}}" class="fas fa-minus"></i></a>
                    <a data-attr="AeP" data-action="advanceWrapper" data-fct="_advancePoints" class="advance"><i data-tooltip="{{actor.system.stats.AeP.cost}}" class="fas fa-plus"></i></a>{{/if}}
                </div>
                <div class="col eight lineheight center">
                    {{formInput systemFields.stats.fields.AeP.fields.initial value=actor.system.stats.AeP.initial}}
                </div>
                <div class="col eight center">
                    {{formInput systemFields.stats.fields.AeP.fields.modifier value=actor.system.stats.AeP.modifier}}
                </div>
                <div class="col eight center">
                    {{formInput systemFields.stats.fields.AeP.fields.advances value=actor.system.stats.AeP.advances}}
                </div>
                <div class="col eight lineheight center">
                    {{actor.system.stats.AeP.max}}
                </div>
            </div>
           
            <div class="derivedAttrs row-section">
                <div class="col two lineheight">
                    {{localize "dsk.CHARAbbrev.AeP"}} {{localize 'dsk.regenerate'}}
                </div>
                <div class="col eight lineheight center">

                </div>
                <div class="col eight center inputTooltipAvailable" data-tooltip="dsk.SHEET.permRegeneration">
                    {{formInput systemFields.stats.fields.regeneration.fields.AePMod value=actor.system.stats.regeneration.AePMod}}
                </div>
                <div class="col eight center inputTooltipAvailable" data-tooltip="dsk.SHEET.tempRegeneration">
                    {{formInput systemFields.stats.fields.regeneration.fields.AePTemp value=actor.system.stats.regeneration.AePTemp}}
                </div>
                <div class="col eight lineheight center">
                    {{actor.system.stats.regeneration.AePmax}}
                </div>
            </div>
            {{/if}}
            <div class="derivedAttrs row-section">
                <div class="col two lineheight">
                    {{localize "dsk.soulpower"}}
                </div>
                <div class="col eight lineheight center">
                    {{formInput systemFields.stats.fields.sk.fields.value value=actor.system.stats.sk.value}}
                </div>
                <div class="col eight center">
                    {{formInput systemFields.stats.fields.sk.fields.modifier value=actor.system.stats.sk.modifier}}
        
                </div>
                <div class="col eight"></div>
                <div class="col eight lineheight center">
                    {{actor.system.stats.sk.max}}
        
                </div>
            </div>
            <div class="derivedAttrs row-section">
                <div class="col two lineheight">
                    {{localize "dsk.toughness"}}
                </div>
                <div class="col eight lineheight center">
                    {{formInput systemFields.stats.fields.zk.fields.value value=actor.system.stats.zk.value}}
                </div>
                <div class="col eight center">
                    {{formInput systemFields.stats.fields.zk.fields.modifier value=actor.system.stats.zk.modifier}}
                </div>
                <div class="col eight"></div>
                <div class="col eight lineheight center">
                    {{actor.system.stats.zk.max}}
                </div>
            </div>

            <div class="derivedAttrs row-section">
                <div class="col two lineheight">
                    {{localize "dsk.actionCount"}}
                </div>
                <div class="col eight lineheight center">
                </div>
                <div class="col eight center">
                </div>
                <div class="col eight"></div>
                <div class="col eight lineheight center">
                    {{formInput systemFields.actionCount value=actor.system.actionCount class="input-text"}}
                </div>
            </div>

            <div class="derivedAttrs row-section">
                <div class="col two lineheight">
                    {{localize "dsk.count"}}
                </div>
                <div class="col two lineheight center">
                    {{formInput systemFields.count value=actor.system.count class="input-text"}}
                </div>
            </div>
            <div class="derivedAttrs row-section">
                <div class="col two lineheight">
                    {{localize "dsk.sizeCategory"}}
                </div>
                <div class="col two lineheight center">
                    <select name="system.details.size" data-dtype="String" style="width:100%">
                        {{selectOptions sizeCategories selected=actor.system.details.size localize=true}}
                    </select>
                </div>
            </div>
            <div class="derivedAttrs row-section">
                <div class="col two lineheight">
                    {{localize "dsk.speed"}}
                </div>
                <div class="col eight lineheight center">
                    {{formInput systemFields.stats.fields.gs.fields.initial value=actor.system.stats.gs.initial}}
                </div>
                <div class="col eight center">
                    {{formInput systemFields.stats.fields.gs.fields.modifier value=actor.system.stats.gs.modifier}}
                </div>
                <div class="col eight">
                </div>
                <div class="col eight lineheight center">
                    {{actor.system.stats.gs.max}}
                </div>
            </div>
            <div class="derivedAttrs row-section">
                <div class="col two lineheight">
                    {{localize "dsk.initiative"}}
                </div>
                <div class="col eight lineheight center">
                    {{formInput systemFields.stats.fields.ini.fields.current value=actor.system.stats.ini.current}}
                </div>
                <div class="col eight center">
                    {{formInput systemFields.stats.fields.ini.fields.modifier value=actor.system.stats.ini.modifier}}
                </div>
                <div class="col eight">
                </div>
                <div class="col eight lineheight center">
                    {{floor actor.system.stats.ini.value}}
                </div>
            </div>
            <div class="derivedAttrs row-section">
                <div class="col two lineheight">
                    {{localize "dsk.initDie"}}
                </div>
                <div class="col two lineheight center">
                    <select name="system.stats.initiative.die" data-dtype="String" style="width:100%">
                        {{selectOptions initDies selected=actor.system.stats.ini.die localize=false}}
                    </select>
                </div>
            </div>
            <div class="derivedAttrs row-section">
                <div class="col two lineheight">
                    {{localize "dsk.fatePoints"}}
                </div>
                <div class="col eight lineheight center">
                    {{formInput systemFields.stats.fields.schips.fields.current value=actor.system.stats.schips.current}}
                </div>
                <div class="col eight center">
                    {{formInput systemFields.stats.fields.schips.fields.modifier value=actor.system.stats.schips.modifier}}
                </div>
                <div class="col eight">
        
                </div>
                <div class="col eight lineheight center">
                    {{actor.system.stats.schips.max}}
                </div>
            </div>
        </div>
        {{#if prepare.canAdvance}}
        <div class="groupbox">
            <div class="experience row-section">
                <div class="col header-label lineheight">
                    <b>{{localize "dsk.Experience"}}</b>
                </div>
            </div>
            <div class="experience row-section">
                <div class="col three header-label">
                    {{localize "dsk.Current"}}
                </div>
                <div class="col three header-label">
                    {{localize "dsk.Spent"}}
                </div>
                <div class="col three header-label">
                    {{localize "dsk.Total"}}
                </div>
            </div>
            <div class="experience row-section">
                <div class="col three lineheight center">
                    {{actor.system.details.experience.current}}
                </div>
                <div class="col three center">
                    {{formInput systemFields.details.fields.experience.fields.spent value=actor.system.details.experience.spent}}
                </div>
                <div class="col three center">
                    {{formInput systemFields.details.fields.experience.fields.total value=actor.system.details.experience.total}}
                </div>

            </div>
        </div>
        {{/if}}

    </div>
</div>
</div>