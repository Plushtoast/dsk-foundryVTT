<form class="{{cssClass}} lock{{prepare.sheetLocked}}" autocomplete="off">


    <header class="sheet-header">

        <div class="headerInput">
            {{formInput fields.name value=document.name placeholder=(localize 'dsk.name') classes="input name"}}
            <a class="actorDrag" data-tooltip="dsk.TT.dragLink"><i class="fas fa-link"></i></a>
            <span class="label name">{{localize "dsk.name"}}</span>
        </div>
        <div class="headerInput">
            <input class="input creatureClass" data-dtype="String" name="system.details.species" type="text" value="{{actor.system.details.species}}" placeholder="{{localize 'dsk.typus'}}" />
            <span class="label creatureClass ">{{localize "dsk.typus"}}</span>
        </div>

    </header>
    <div class="general">
        <img class="charimg profile" src="{{actor.img}}" data-tooltip="{{actor.name}}" data-edit="img">
    
        <div class="row-section" style="width: 100%;margin-bottom: 20px">
            <div class="col">
                {{> systems/dsk/templates/actors/parts/rollhead.hbs}}
    
                <div class="row-section flexaligncenter">
                    <div class="col eighty">
                        {{> systems/dsk/templates/actors/parts/healthbar.hbs}}
                        {{#if prepare.schips}}
                        <div class="row-section">
                            <div class="col ten lineheight center" data-tooltip="dsk.fatePoints">
                                {{localize 'dsk.CHARAbbrev.fatePoints'}}
                            </div>
                            <div class="col eighty center" data-tooltip="dsk.fatePoints">
                                <input class="dskhidden" type="text" name="system.stats.schips.value" data-dtype="Number" value="{{actor.system.stats.schips.value}}" /> 
                                {{#each prepare.schips as |item i|}}
                                <a class="schip {{item.cssClass}}" data-val="{{item.value}}"></a>
                                {{/each}}
                            </div>
                            <div class="col ten center">
                            </div>
                        </div>
                        {{/if}}
                    </div>
                    <div class="col row-section five maxDefense" style="min-height:65px;" data-tooltip="dsk.ABBR.VW">
                        <div class="center col dskrelative diet-shield d20height" data-tooltip="{{actor.system.maxDefense.name}}">
                            <h3>{{actor.system.maxDefense.parry}}</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <section id="tab-sections ">
        <nav id="dsk-primarytabs" class="sheet-tabs tabs" data-group="sheet">
            {{#if (ne merchantType 'loot')}}
            <a class="item" data-action="tab" data-group="sheet" data-tab="skills">{{localize "TYPES.Item.skill"}}</a>
            <a class="item" data-action="tab" data-group="sheet" data-tab="combat">{{localize "dsk.SPECIALABILITYCATEGORIES.combat"}}</a> 
            {{#if prepare.magic.hasSpells}}
            <a class="item" data-action="tab" data-group="sheet" data-tab="magic">{{localize "dsk.SPECIALABILITYCATEGORIES.ahnen"}}</a> 
            {{/if}}
            <a class="item" data-action="tab" data-group="sheet" data-tab="main">{{localize "dsk.attributes"}}</a>
            {{/if}}
            <a class="item active" data-action="tab" data-group="sheet" data-tab="inventory">{{invName}}</a> 
            {{#if (ne merchantType 'loot')}}
            <a class="item" data-action="tab" data-group="sheet" data-tab="status">{{localize "dsk.status"}}</a>
            <a class="item" data-action="tab" data-group="sheet" data-tab="notes">{{localize "dsk.notes"}}</a> {{/if}}
        </nav>

        <section class="content ">
            <div class="tab main save-scroll" data-tab="main" data-group="sheet">
                {{> systems/dsk/templates/actors/creature/creature-main.hbs}}
            </div>
            <div class="tab skills save-scroll" data-tab="skills" data-group="sheet">
                {{> systems/dsk/templates/actors/actor-talents.hbs}}
            </div>
            <div class="tab combat save-scroll" data-tab="combat" data-group="sheet">
                {{> systems/dsk/templates/actors/creature/creature-combat.hbs}}
            </div>
            {{#if prepare.magic.hasSpells}}
            <div class="tab magic save-scroll" data-tab="magic" data-group="sheet">
                {{> systems/dsk/templates/actors/creature/creature-magic.hbs}}
            </div>
            {{/if}}
            <div class="tab inventory save-scroll" data-tab="inventory" data-group="sheet">
                {{> systems/dsk/templates/actors/merchant/merchant-commerce.hbs}}
            </div>
            <div class="tab status save-scroll" data-tab="status" data-group="sheet">
                {{> systems/dsk/templates/actors/parts/status_effects.hbs}}
            </div>
            <div class="tab save-scroll" data-tab="notes">
                {{> systems/dsk/templates/actors/creature/creature-notes.hbs}}
            </div>
        </section>
    </section>
</form>