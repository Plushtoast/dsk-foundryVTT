<div class="tab scrollable status {{tab.cssClass}}" data-tab="status" data-group="{{tab.group}}">
<div class="actor-status groupbox">
    <div class="actor-status-header row-section">
        <div class="col ten">

        </div>
        <div class="col eighty header-label lineheight">
            <b>{{localize "dsk.statuseffects"}}</b>
        </div>
        <div class="col ten center flexrow flexAlignCenter">
            <button type="button" data-action="statusCreate" class="icon fas fa-plus noBorder dskdesignbutton very-small" data-tooltip="dsk.CONDITION.add"></button>
            <div class="statusEffectMenu">
                <ul>
                    <li class="search">
                        <div class="flexrow">
                            <input type="search" class="conditionSearch" placeholder="{{localize 'dsk.search'}}" />
                            <button type="button" data-action="statusAdd" data-id="custom" data-tooltip="dsk.CONDITION.custom"><i class="fas fa-plus"></i></button>
                        </div>                            
                    </li>
                    {{#each manualConditions as |item i|}}
                    <li>
                        <button type="button" data-action="statusAdd" data-id="{{item.id}}" data-tooltip="{{item.name}}"><img src="{{item.img}}" /></button>
                    </li>
                    {{/each}}

                </ul>
            </div>
        </div>
    </div>
    <div class="row-section mainEffects wrap">

        <div class="col morph row-section skills table-title">
            <div class="col ten">

            </div>
            <div class="col sixty">
                {{localize "dsk.condition"}}
            </div>

            <div class="col ten center">
                {{localize "dsk.ABBR.modifiers"}}
            </div>
            <div class="col ten center" data-tooltip="dsk.value">
                {{localize "dsk.ABBR.value"}}
            </div>
            <div class="actor-status-action col ten">

            </div>
        </div>
        <div class="col morph row-section skills table-title onlyMultiColumn">
            <div class="col ten">

            </div>
            <div class="col sixty">
                {{localize "dsk.condition"}}
            </div>

            <div class="col ten center">
                {{localize "dsk.ABBR.modifiers"}}
            </div>
            <div class="col ten center" data-tooltip="dsk.value">
                {{localize "dsk.ABBR.value"}}
            </div>
            <div class="actor-status-action col ten">

            </div>
        </div>
        {{#each conditions as |item i|}}
        <div class="row-section col morph skills" data-id="{{item._id}}" {{#if item.descriptor}}data-descriptor="{{item.descriptor}}" {{/if}} {{{ifThen item.disabled 'style="opacity:0.5;"' ''}}}>
            <div class="status-img col ten flexcol flexAlignCenter statusEffect effectConfig">
                <img src="{{item.img}}" />
            </div>
            <div class="col sixty flexcol">
                <div class="ellipsis">
                    <a data-action="conditionShow" class="gTooltip" data-category="effect" data-id="{{item._id}}">{{localize item.name}}</a>
                </div>
            </div>
            <div class="col ten center flexrow">
                {{#if item.editable}}{{#unless item.boolean}}
                    <button type="button" class="dskdesignbutton noBorder" data-action="conditionValue">{{item.manual}}</button>
                {{/unless}}{{/if}}
            </div>
            <div class="col ten center flexrow" data-tooltip="dsk.value">
                <span>{{item.value}}</span>
            </div>
            <div class="actor-status-action col ten right flexrow">
                <button type="button" data-action="statusContextMenu" class="icon fas fa-ellipsis-vertical very-small autoFlex noBorder dskdesignbutton" data-tooltip="dsk.SHEET.EditItem"></button>
            </div>
        </div>
        {{/each}}
        {{#if (oddLength conditions)}}
        <div class="col morph">
        </div>
        {{/if}}
    </div>

</div>

<div class="actor-status groupbox">
    <div class="actor-status-header row-section" data-tooltip="dsk.cummulativeStatusEffectsHint">
        <div class="col ten">

        </div>
        <div class="col eighty header-label lineheight">
            <b>{{localize "dsk.cummulativeStatusEffects"}}</b>
        </div>
        <div class="col ten center">

        </div>
    </div>
    <div class="row-section wrap">

        <div class="col morph row-section skills table-title">
            <div class="col ten">

            </div>
            <div class="col sixty">
                {{localize "dsk.condition"}}
            </div>

            <div class="col ten center">

            </div>
            <div class="col ten center" data-tooltip="dsk.value">
                {{localize "dsk.ABBR.value"}}
            </div>
            <div class="actor-status-action col ten">

            </div>
        </div>
        <div class="col morph row-section skills table-title onlyMultiColumn">
            <div class="col ten">

            </div>
            <div class="col sixty">
                {{localize "dsk.condition"}}
            </div>

            <div class="col ten center">

            </div>
            <div class="col ten center" data-tooltip="dsk.value">
                {{localize "dsk.ABBR.value"}}
            </div>
            <div class="actor-status-action col ten">

            </div>
        </div>
        {{#each cumulativeConditions as |item i|}}
        <div class="row-section morph skills col statusEffect" data-id="{{item.id}}" data-descriptor="{{item.id}}">
            <div class="status-img col ten effectConfig">
                <img src="{{item.img}}" />
            </div>
            <div class="col sixty ellipsis">
                <a data-action="conditionShow" class="gTooltip" data-category="effect" data-id="{{item.id}}">{{localize item.name}}</a>
            </div>
            <div class="col ten center">

            </div>
            <div class="col ten center" data-tooltip="dsk.value">
                <span>{{item.value}}</span>
            </div>
            <div class="actor-status-action col ten right">

            </div>
        </div>
        {{/each}}
        {{#if (oddLength cumulativeConditions)}}
        <div class="col morph">
        </div>
        {{/if}}
    </div>

</div>

<div class="actor-status groupbox">
    <div class="actor-status-header row-section">
        <div class="col ten">

        </div>
        <div class="col eighty header-label lineheight">
            <b>{{localize "dsk.transferredStatusEffects"}}</b>
        </div>
        <div class="col ten center">

        </div>
    </div>

    <div class="row-section wrap">

        <div class="col morph row-section skills table-title">
            <div class="col ten">

            </div>
            <div class="col sixty">
                {{localize "dsk.condition"}}
            </div>

            <div class="col five center">
                {{localize 'dsk.source'}}
            </div>
            <div class="actor-status-action col ten">

            </div>
        </div>
        <div class="col morph row-section skills table-title onlyMultiColumn">
            <div class="col ten">

            </div>
            <div class="col sixty">
                {{localize "dsk.condition"}}
            </div>

            <div class="col five center">
                {{localize 'dsk.source'}}
            </div>
            <div class="actor-status-action col ten">

            </div>
        </div>
        {{#each transferedConditions as |item i|}}
        <div class="row-section morph skills col statusEffect" data-item-id="{{item.parent.id}}" data-origin="{{item.uuid}}" data-id="{{item._id}}" {{#if item.descriptor}}data-descriptor="{{item.descriptor}}"{{/if}} {{{ifThen item.disabled 'style="opacity:0.5;"' ''}}}>
            <div class="status-img col ten effectConfig">
                <img src="{{item.img}}" /> 
            </div>
            <div class="col sixty ellipsis">
                <a data-action="conditionEdit" class="gTooltip" data-category="effect" data-uuid="{{item.uuid}}" data-locked="true" data-id="{{item._id}}">{{localize item.name}}</a>
            </div>
            <div class="col five center">
                <a data-action="conditionEdit" class="condition-edit" data-uuid="{{item.parent.uuid}}"><i class="fas fa-info" data-tooltip="{{item.parent.name}}"></i></a>
            </div>
            <div class="actor-status-action col ten right flexrow">
                <button type="button" data-action="statusContextMenu" class="icon fas fa-ellipsis-vertical very-small autoFlex noBorder dskdesignbutton" data-tooltip="dsk.SHEET.EditItem"></button>
            </div>
        </div>
        {{/each}}
        {{#if (oddLength transferedConditions)}}
        <div class="col morph">
        </div>
        {{/if}}
    </div>

</div>


<div class="groupbox">
    <div class="row-section">
        <div class="col header-label lineheight">
            <b>{{localize "dsk.SHEET.actorConfig"}}</b>
        </div>
    </div>
    <div class="row-section wrap">
        {{#if actor.system.repeatingEffects.startOfRound.LeP}}
        <div class="row-section skills col morph">
            <div class="col nintey">
                {{localize 'dsk.regenerate'}} {{localize 'dsk.CHARAbbrev.CR'}} ({{localize 'dsk.LeP'}})
            </div>
            <div class="col five">
                
            </div>
            <div class="col ten">
                <a data-action="disableRegeneration" data-type="wounds">{{#if actor.system.repeatingEffects.disabled.LeP}}<i class="far fa-circle"></i>{{else}}<i class="far fa-check-circle"></i>{{/if}}</a>
            </div>
        </div>
        {{/if}}

        {{#if actor.system.repeatingEffects.startOfRound.AeP}}
        <div class="row-section skills col morph">
            <div class="col nintey">
                {{localize 'dsk.regenerate'}} {{localize 'dsk.CHARAbbrev.CR'}} ({{localize 'dsk.AeP'}})
            </div>
            <div class="col ten">
                <a data-action="disableRegeneration" data-type="astralenergy">{{#if actor.system.repeatingEffects.disabled.AeP}}<i class="far fa-circle"></i>{{else}}<i class="far fa-check-circle"></i>{{/if}}</a>
            </div>
        </div>
        {{/if}}
        
    </div>
</div>
</div>