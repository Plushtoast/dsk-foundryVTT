<header class="sheet-header">
    <div class="charname headerInput">
        <input class="input name" name="name" style="width:90%" type="text" value="{{actor.name}}" placeholder="{{localize 'dsk.name'}}" />
        <a class="actorDrag" data-tooltip="dsk.TT.dragLink"><i class="fas fa-link"></i></a>
        <span class="label name">{{localize "dsk.name"}}</span>
    </div>

    <div class="headerInput" {{#unless actor.system.details.species}}data-tooltip="dsk.addSpeciesHint"{{/unless}}>
        {{formInput systemFields.details.fields.species value=document.system.details.species readonly=true placeholder=(localize 'TYPES.Item.species') classes="input species"}}
        <span class="label species">{{localize 'TYPES.Item.species'}}</span>
    </div>
    <div id="field-careerlevel" class="headerInput">
        {{formInput systemFields.details.fields.profession value=document.system.details.profession placeholder=(localize 'TYPES.Item.profession') classes="input-details"}}
        <span class="label-details">{{localize "TYPES.Item.profession"}}</span>
    </div>
</header>

<div class="general">
    <img class="charimg profile" src="{{actor.img}}" data-tooltip="{{actor.name}}" data-edit="img">

    <div class="row-section" style="width: 100%;margin-bottom: 20px">
        <div class="col">
            {{> systems/dsk/templates/actors/parts/rollhead.html}}
            <div class="row-section flexaligncenter">
                <div class="col eighty ">
                {{> systems/dsk/templates/actors/parts/healthbar.html}}
                    {{#if prepare.schips}}
                    <div class="row-section">
                        <div class="col ten lineheight center" data-tooltip="dsk.fatePoints">
                            {{localize 'dsk.CHARAbbrev.fatePoints'}}
                        </div>
                        <div class="col eighty center" data-tooltip="dsk.fatePoints">
                            {{#each prepare.schips as |item i|}}
                            <a class="schip {{item.cssClass}}" data-val="{{item.value}}"></a>
                            {{/each}}
                        </div>
                        <div class="col ten center">
                        </div>
                    </div>
                    {{/if}}
                </div>
                <div class="col row-section five maxDefense" style="min-height:65px;" data-tooltip="dsk.ABBR.VW">
                    <div class="center col dskrelative diet-shield d20height" data-tooltip="{{actor.system.maxDefense.name}}">
                        <h3>{{actor.system.maxDefense.parry}}</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>