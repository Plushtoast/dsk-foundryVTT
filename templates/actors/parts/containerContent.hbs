<ul>
    <li class="main-row">
        <div class="row-section wrap rowtable inventory">
            {{#each children as |item i|}}
            <div class="col item" data-item-id="{{item._id}}" data-category="{{item.system.category}}">
                <div class="row-section">
                    <div class="col eight image {{item.enchantClass}}">
                        <div class="image" style="background-image: url('{{item.img}}')">
                        </div>
                    </div>
                    <div class="col withContext">
                        <a data-action="itemEdit" class="item-edit {{#if item.consumable}}consume-item{{/if}}">{{item.name}}</a>
                    </div>
                    <div class="col eight"></div>
                    {{#if (eq item.system.category 'bags')}}
                    <div class="col five center">
                        {{item.system.bagweight}}
                    </div>
                    {{/if}}
                    <div class="col eight center">
                        {{#if item.toggle}} {{#if item.toggleValue}}
                        <a data-action="itemToggle" class="item-toggle"><i class="far fa-check-circle"></i></a> {{else}}
                        <a data-action="itemToggle" class="item-toggle"><i class="far fa-circle"></i></a> {{/if}} {{/if}}
                    </div>

                    <div class="col eight center">
                        <a data-action="quantityClick" class="quantity-click">{{item.system.quantity}}</a>
                    </div>
                    <div class="col eight center">
                        {{item.system.preparedWeight}}
                    </div>
                    <div class="col ten very-small center flexrow">
                        {{#if item.children}}
                        <button type="button" data-action="itemDropdown" class="icon fas fa-chevron-down very-small noBorder autoFlex dskdesignbutton" data-tooltip="dsk.SHEET.Dropdown"></button>
                        {{/if}}
                        <button type="button" data-action="itemContextMenu" class="icon fas fa-ellipsis-vertical very-small autoFlex noBorder dskdesignbutton" data-tooltip="dsk.SHEET.EditItem"></button>
                    </div>
                </div>
                <div class="row-section lineheight expandDetails {{item.detailed}}">
                    <div class="col">
                        {{#if item.children}} {{> systems/dsk/templates/actors/parts/containerContent.hbs item}} {{/if}}
                    </div>
                </div>

            </div>
            {{/each}}
        </div>
    </li>
</ul>