<form class="{{cssClass}}" autocomplete="off">
    {{> systems/dsk/templates/actors/parts/normalhead.hbs}}
    <!-- TABS -->
    <section id="tab-sections">
        {{> systems/dsk/templates/system/dsktabs.hbs}}

        <section class="content">
            <div class="tab main save-scroll {{tabs.main.cssClass}}" data-tab="main" data-group="{{tabs.main.group}}">
                {{> systems/dsk/templates/actors/npc/npc-main.hbs}}
            </div>
            <div class="tab skills save-scroll {{tabs.skills.cssClass}}" data-tab="skills" data-group="{{tabs.skills.group}}">
                {{> systems/dsk/templates/actors/actor-talents.hbs}}
            </div>
            <div class="tab combat save-scroll {{tabs.combat.cssClass}}" data-tab="combat" data-group="{{tabs.combat.group}}">
                {{> systems/dsk/templates/actors/actor-combat.hbs}}
            </div>
            {{#if tabs.magic}}
            <div class="tab magic save-scroll {{tabs.magic.cssClass}}" data-tab="magic" data-group="{{tabs.magic.group}}">
                {{> systems/dsk/templates/actors/character/actor-magic.hbs}}
            </div>
            {{/if}} 
            <div class="tab inventory save-scroll {{tabs.inventory.cssClass}}" data-tab="inventory" data-group="{{tabs.inventory.group}}">
                {{> systems/dsk/templates/actors/actor-equipment.hbs}}
            </div>
            <div class="tab status save-scroll {{tabs.status.cssClass}}" data-tab="status" data-group="{{tabs.status.group}}">
                {{> systems/dsk/templates/actors/parts/status_effects.hbs}}
            </div>
            <div class="tab save-scroll {{tabs.notes.cssClass}}" data-tab="notes" data-group="{{tabs.notes.group}}">
                {{> systems/dsk/templates/actors/actor-notes.hbs}}
            </div>
        </section>
    </section>
</form>