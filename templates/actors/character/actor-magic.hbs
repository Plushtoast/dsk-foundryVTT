<div class="tab scrollable gap0px magic {{tab.cssClass}}" data-tab="magic" data-group="{{tab.group}}">
<div class="groupbox">
    <div class="row-section wrap inverseRowtable">
        <div class="col">
            <div class="row-section skills table-title">
                <div class="col four flexrow">
                    {{localize "TYPES.Item.ahnengabe"}}
                </div>
                <div class="col four flexrow flexAlignCenter">{{localize "dsk.probe"}}</div>
                <div class="col ten flexrow flexAlignCenter" data-tooltip="dsk.FW">{{localize "dsk.CHARAbbrev.FW"}}</div>
                <div class="col ten flexrow flexAlignCenter" data-tooltip="dsk.PW">{{localize "dsk.CHARAbbrev.PW"}}</div>
                <div class="col ten flexrow flexAlignCenter" data-tooltip="dsk.AeP">{{localize "dsk.CHARAbbrev.AeP"}}</div>
                <div class="col ten flexrow flexAlignCenter">{{localize "dsk.range"}}</div>
                <div class="col ten flexrow">
                    <button type="button" data-action="itemCreate" class="dskdesignbutton noBorder item-create very-small" data-tooltip="dsk.SHEET.addItem" item-section="ahnengabe" data-type="ahnengabe"><i class="fas fa-plus"></i></button>
                </div>
            </div>
        </div>
        {{#each prepare.magic.ahnengabe as |item i|}}
        <div class="col spells item" data-item-id="{{item._id}}">
            <div class="row-section skills lineheight">
                <div class="col four flexrow withContext">
                    <div>
                    <a data-action="itemEdit" class="item-edit">{{item.name}}</a> {{#if item.canAdvance}}
                    <a data-action="advanceWrapper" data-fct="_refundItemAdvance" data-attr="{{item._id}}" class="advance refund-item"><i data-tooltip="{{item.refund}}" class="fas fa-minus"></i></a>
                    <a data-action="advanceWrapper" data-fct="_advanceItem" data-attr="{{item._id}}" class="advance advance-item"><i data-tooltip="{{item.cost}}" class="fas fa-plus"></i></a>{{/if}}
                    </div>
                </div>
                <div class="col four center">
                    <a data-action="spellSelect" class="spell-select">
                        <span class="d20 diet-{{item.system.characteristic1}}">{{attrLoc item.system.characteristic1 "abbr"}}</span>
                        <span class="d20 diet-{{item.system.characteristic2}}">{{attrLoc item.system.characteristic2 "abbr"}}</span>
                    </a>
                </div>
                <div class="col ten center">
                    <input class="skill-advances" type="text" data-dtype="Number" value="{{item.system.level}}" />
                </div>
                <div class="col ten flexrow flexAlignCenter">
                    {{item.PW}}
                </div>
                <div class="col ten flexrow flexAlignCenter">
                    {{item.system.AeP}}
                </div>
                
                <div class="col ten flexrow flexAlignCenter">
                    {{item.system.range}}
                </div>

                <div class="col ten very-small center flexrow">
                    <button type="button" data-action="itemContextMenu" class="icon fas fa-ellipsis-vertical very-small autoFlex noBorder dskdesignbutton" data-tooltip="dsk.SHEET.EditItem"></button>
                </div>
            </div>
            <div class="row-section lineheight expandDetails {{item.detailed}}">
                <div class="col">
                    <ul>
                        <li><b>{{localize "dsk.duration"}}</b>: {{item.system.duration}}</li>
                    </ul>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
</div>

<div class="groupbox">
    <div class="row-section">
        <div class="col header-label lineheight">
            <b>{{localize "dsk.SPECIALABILITYNAMES.ahnen"}}</b>
        </div>
    </div>
    <div class="row-section wrap cards">
        {{#each prepare.specAbs.ahnen as |item i|}}
        <div class="item" data-item-id="{{item._id}}">
            {{#if item.OnUseEffect}}<a data-action="onUseItem" data-tooltip="dsk.SHEET.onUseEffect" class="onUseItem"><i class="fas fa-dice-six"></i></a>{{/if}}<a data-action="itemEdit" class="item-edit">{{item.name}}{{roman item.system.level item.system.max}}</a>
        </div>
        {{/each}}
    </div>
</div>

<div class="row-section">
    <div class="col two">
        <div class="groupbox">
            <div class="row-section lineheight">
                <div class="col fourty center">
                    {{localize "dsk.guidevalue"}}
                </div>
                <div class="col sixty">
                    <div class="form-group">
                        <select name="system.guidevalue" data-dtype="String">
                            {{selectOptions prepare.guidevalues selected=actor.system.guidevalue localize=true}}
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col two">
        <div class="groupbox">
            <div class="row-section">
                <div class="col header-label lineheight">
                    <b>{{localize "TYPES.Item.ahnengeschenk"}}</b>
                </div>
            </div>
            <div class="row-section wrap cards">
                {{#each prepare.magic.ahnengeschenk as |item i|}}
                <div class="item" data-item-id="{{item._id}}">
                    <a data-action="itemEdit" class="item-edit">{{item.name}}</a>
                </div>
                {{/each}}
            </div>
        </div>
    </div>
</div>
</div>