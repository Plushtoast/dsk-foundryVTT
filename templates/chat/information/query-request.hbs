<div class="information-query-request">
    <p><b>{{itemName}}</b></p>
    <p>{{actorName}} ({{playerName}})</p>
    <p>{{skillName}} - {{localize "dsk.CHARAbbrev.QS"}} {{rolledQS}}</p>
    <div class="chat-button-gm">
        <button class="informationQueryApprove" data-uuid="{{itemUuid}}" data-player-id="{{playerId}}" data-rolled-qs="{{rolledQS}}" data-success-level="{{successLevel}}">
            <i class="fas fa-check"></i> {{localize "dsk.INFORMATIONQUERY.approve"}}
        </button>
    </div>
</div>
