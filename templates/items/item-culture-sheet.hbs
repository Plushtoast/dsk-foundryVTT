<form class="dsk item-sheet {{cssClass}}" autocomplete="off">
    {{> systems/dsk/templates/items/item-header.hbs}}

    <div class="row-section ">

        <div class="col item-main noequipment" style="margin-bottom: 10px;">
            <div class="row-section">
                <div class="col fourty">
                    <label class="label-text table-title">{{localize "dsk.category"}}</label>
                </div>
                <div class="col sixty">
                    <label>{{itemCategory item.type}}</label>
                </div>
            </div>

        </div>
    </div>

    {{> systems/dsk/templates/system/dsktabs.hbs}}

    <section class="content">
        <div class="tab description standard-form scrollable {{tabs.description.cssClass}}" data-tab="description" data-group="{{tabs.description.group}}">
            <div class="row-section">
                <div class="col sixty">
                    {{formInput systemFields.description.fields.value value=document.system.description.value toggled=true enriched=enrichedDescription}}
                </div>
                <div class="col fourty">
                    <img src="{{item.img}}" style="max-width:100%; max-height: 100%;float: left;" data-edit="img" />
                </div>
            </div>
        </div>

        <div class="tab details standard-form scrollable {{tabs.details.cssClass}}" data-tab="details" data-group="{{tabs.details.group}}">
            {{formGroup systemFields.skills value=document.system.skills localize=true elementType="textarea" classes="full-height"}}
            
        </div>
    </section>
</form>