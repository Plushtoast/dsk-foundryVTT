<div class="tab standard-form scrollable {{tabs.description.cssClass}}" data-tab="description" data-group="{{tabs.description.group}}">
    <div>
        {{#if hasLocalization}}
        <img src="{{item.img}}" style="max-width:50%; max-height: 100%;float:right;" data-edit="img" />
        {{{localize (concat "dsk.Racedescr." item.name)}}}
        {{else}}
        <div class="row-section">
            <div class="col two">
                {{formInput systemFields.description.fields.value value=document.system.description.value toggled=true enriched=enrichedDescription}}
            </div>
            <div class="col two">
                <img src="{{item.img}}" style="max-width:100%; max-height: 100%;" data-edit="img" />
            </div>
        </div>
        {{/if}}
    </div>
</div>
