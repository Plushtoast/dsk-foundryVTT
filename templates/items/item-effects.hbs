<div class="tab effects standard-form scrollable {{tabs.effects.cssClass}}" data-tab="effects" data-group="{{tabs.effects.group}}">

    <div class="row-section wrap">

        <div class="col row-section skills table-title">
            <div class="col ten">

            </div>
            <div class="col two">
                {{localize "dsk.condition"}}
            </div>

            <div class="col ten center">
                {{localize "dsk.ABBR.modifiers"}}
            </div>
            <div class="col ten center" data-tooltip="dsk.value">
                {{localize "dsk.ABBR.value"}}
            </div>
            <div class="col five right">
                <button type="button" class="icon noBorder fa fa-plus" data-action="statusAdd" data-tooltip="dsk.CONDITION.add"></button>
            </div>
        </div>
        {{#each conditions as |item i|}}
        <div class="row-section col skills statusEffect" data-id="{{item._id}}">
            <div class="col ten">
                {{#if item.disabled}}
                <img style="opacity:0.5;" src="{{item.img}}" /> {{else}}
                <img src="{{item.img}}" /> {{/if}}
            </div>
            <div class="col two">
                <a data-action="conditionShow" class="condition-show" data-id="{{item._id}}">{{localize item.name}}</a>
            </div>
            <div class="col ten center">
                {{#if item.editable}}{{#unless item.boolean}}<a data-action="conditionValue" class="condition-value">{{item.manual}}</a>{{/unless}}{{/if}}
            </div>
            <div class="col ten center" data-tooltip="dsk.value">
                <span>{{item.value}}</span>
            </div>
            <div class="col five right">
                <a data-action="conditionEdit" class="condition-edit" data-tooltip="dsk.SHEET.EditItem" data-id="{{item._id}}"><i class="fa fa-edit"></i></a> {{#if item.disabled}}
                <a data-action="conditionToggle" class="condition-toggle" data-tooltip="dsk.SHEET.activate"><i class="far fa-circle"></i></a> {{else}}
                <a data-action="conditionToggle" class="condition-toggle" data-tooltip="dsk.SHEET.deactivate"><i class="far fa-check-circle"></i></a> {{/if}}
            </div>
        </div>
        {{/each}} {{#each transferedConditions as |item i|}}
        <div class="row-section col skills statusEffect" data-id="{{item._id}}">
            <div class="col ten">
                {{#if item.disabled}}
                <img style="opacity:0.5;" src="{{item.img}}" /> {{else}}
                <img src="{{item.img}}" /> {{/if}}
            </div>
            <div class="col two">
                <a data-action="conditionShow" class="condition-show" data-id="{{item._id}}">{{localize item.name}}</a>
            </div>
            <div class="col ten center">
                {{#if item.editable}}{{#unless item.boolean}}<a data-action="conditionValue" class="condition-value">{{item.manual}}</a>{{/unless}}{{/if}}
            </div>
            <div class="col ten center" data-tooltip="dsk.value">
                <span>{{item.value}}</span>
            </div>
            <div class="col five right">
                <a data-action="conditionEdit" class="condition-edit" data-tooltip="dsk.SHEET.EditItem" data-id="{{item._id}}"><i class="fa fa-edit"></i></a> {{#if item.disabled}}
                <a data-action="conditionToggle" class="condition-toggle" data-tooltip="dsk.SHEET.activate"><i class="far fa-circle"></i></a> {{else}}
                <a data-action="conditionToggle" class="condition-toggle" data-tooltip="dsk.SHEET.deactivate"><i class="far fa-check-circle"></i></a> {{/if}}
            </div>
        </div>
        {{/each}}
    </div>
</div>