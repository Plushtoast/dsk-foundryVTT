<div class="tab standard-form gap2px scrollable {{tabs.details.cssClass}}" data-tab="details" data-group="{{tabs.details.group}}">
    {{formGroup systemFields.level value=document.system.level localize=true}}
    {{formGroup systemFields.category value=document.system.category localize=true}}
    {{formGroup systemFields.resist value=document.system.resist localize=true}}
    {{formGroup systemFields.effect value=document.system.effect localize=true}}
    {{formGroup systemFields.start value=document.system.start localize=true}}
    {{formGroup systemFields.duration value=document.system.duration localize=true}}
    <div class="form-group">
        <label class="label-text">{{localize "dsk.search"}} / {{localize "dsk.process"}}</label>
        <div class="form-fields">
            {{formInput systemFields.search value=document.system.search}}
            {{formInput systemFields.process value=document.system.process}}
        </div>
    </div>
</div>