<div class="tab details standard-form scrollable {{tab.cssClass}}" data-tab="details" data-group="{{tab.group}}">
    {{formGroup systemFields.requirements.fields.advantage value=document.system.requirements.advantage localize=true elementType="textarea" classes="full-height"}}
    {{formGroup systemFields.requirements.fields.specialability value=document.system.requirements.specialability localize=true elementType="textarea" classes="full-height"}}

    {{formGroup systemFields.skills.fields.body value=document.system.skills.body localize=true elementType="textarea" classes="full-height"}}
    {{formGroup systemFields.skills.fields.social value=document.system.skills.social localize=true elementType="textarea" classes="full-height"}}
    {{formGroup systemFields.skills.fields.mental value=document.system.skills.mental localize=true elementType="textarea" classes="full-height"}}
    {{formGroup systemFields.skills.fields.trade value=document.system.skills.trade localize=true elementType="textarea" classes="full-height"}}
    {{formGroup systemFields.skills.fields.combat value=document.system.skills.combat localize=true elementType="textarea" classes="full-height"}}

    {{formGroup systemFields.isAncestor value=document.system.isAncestor localize=true}}

    {{#if system.isAncestor}}
    {{formGroup systemFields.ahnengabe value=document.system.ahnengabe localize=true elementType="textarea" classes="full-height"}}
    {{formGroup systemFields.ahnengeschenk value=document.system.ahnengeschenk localize=true elementType="textarea" classes="full-height"}}
    {{/if}}
</div>