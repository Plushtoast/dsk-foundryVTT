<form class="dsk item-sheet {{cssClass}}" autocomplete="off">
    {{> systems/dsk/templates/items/item-header.hbs}} {{> systems/dsk/templates/items/item-stat.hbs}}


    <nav class="sheet-tabs tabs" data-tab-container="primary">
        <a class="item active" data-tab="description">{{localize "dsk.description"}}</a>
        <a class="item" data-tab="details">{{localize "dsk.details"}}</a>
        <a class="item" data-tab="effects">{{localize "dsk.statuseffects"}}</a>
    </nav>

    <section class="content">

        <div class="tab description active" data-tab="description">
            {{#if hasLocalization}} {{{localize (concat "dsk.Combatskilldescr." item.name)}}} {{else}} {{editor enrichedDescription target="system.description.value" button=true owner=owner editable=editable engine="prosemirror"}} {{/if}}
        </div>

        <div class="tab details" data-tab="details">

            {{formGroup systemFields.characteristic1 value=document.system.characteristic1 localize=true}}
            {{formGroup systemFields.characteristic2 value=document.system.characteristic2 localize=true}}
            {{formGroup systemFields.weapontype value=document.system.weapontype localize=true}}
            {{formGroup systemFields.encumbers value=document.system.encumbers localize=true}}
            {{formGroup systemFields.StF value=document.system.StF localize=true}}

            
        </div>
        {{> systems/dsk/templates/items/item-effects.hbs}}
    </section>
</form>