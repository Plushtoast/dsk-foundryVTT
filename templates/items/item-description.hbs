<div class="tab standard-form scrollable {{tabs.description.cssClass}}" data-tab="description" data-group="{{tabs.description.group}}">
    <div class="margin-top">
        <div class="row-section">
            <div class="col {{#unless document.system.description.value}}item-box{{/unless}}">
                {{formInput systemFields.description.fields.value value=document.system.description.value toggled=true enriched=enrichedDescription}}
            </div>
        </div>
    </div>
    {{#if isGM}}
    <div class="row-section margin-top">
        <div class="col maskfield">
            <div class="row-section" data-tooltip="dsk.TT.onlyGM">
                <div class="col {{#unless document.system.description.gminfo}}item-box{{/unless}}">
                    {{formInput systemFields.description.fields.gminfo value=document.system.description.gminfo toggled=true enriched=enrichedGmdescription}}
                </div>
            </div>
        </div>
    </div>
    {{/if}}
</div>