<div class="tab details standard-form scrollable {{tab.cssClass}}" data-tab="details" data-group="{{tab.group}}">
    <div class="form-group">
        <label class="label-text">{{localize "TYPES.Item.skill"}}</label>
        <select name="system.skill" data-dtype="String">
            {{selectOptions (selfObj allSkills) selected=system.skill}}
        </select>
    </div>
    {{formGroup systemFields.modifier value=document.system.modifier localize=true}}
    {{formGroup systemFields.qs1 value=document.system.qs1 localize=true elementType="textarea" classes="full-height"}}
    {{formGroup systemFields.qs2 value=document.system.qs2 localize=true elementType="textarea" classes="full-height"}}
    {{formGroup systemFields.qs3 value=document.system.qs3 localize=true elementType="textarea" classes="full-height"}}
    {{formGroup systemFields.qs4 value=document.system.qs4 localize=true elementType="textarea" classes="full-height"}}
    {{formGroup systemFields.qs5 value=document.system.qs5 localize=true elementType="textarea" classes="full-height"}}
    {{formGroup systemFields.qs6 value=document.system.qs6 localize=true elementType="textarea" classes="full-height"}}
</div>