<form class="dsk item-sheet {{cssClass}}" autocomplete="off">
    {{> systems/dsk/templates/items/item-header.hbs}}

    <div class="row-section ">

        <div class="col item-main noequipment">
            <div class="row-section">
                <div class="col fourty">
                    <label class="label-text table-title">{{localize "dsk.category"}}</label>
                </div>
                <div class="col sixty">
                    <label>{{itemCategory item.type}}</label>
                </div>
            </div>

        </div>
    </div>

    <nav class="sheet-tabs tabs" data-tab-container="primary">
        <a class="item active" data-tab="description">{{localize "dsk.description"}}</a>
        <a class="item" data-tab="details">{{localize "dsk.details"}}</a>
    </nav>

    <section class="content career">
        <div class="tab description" data-tab="description">
            <div>
                {{#if hasLocalization}}
                <img src="{{item.img}}" style="max-width:50%; max-height: 100%;float:right;" data-edit="img" /> {{{localize (concat "dsk.Racedescr." item.name)}}} {{else}}
                <div class="row-section">
                    <div class="col two">
                        {{editor enrichedDescription target="system.description.value" button=true owner=owner editable=editable engine="prosemirror"}}
                    </div>
                    <div class="col two">
                        <img src="{{item.img}}" style="max-width:100%; max-height: 100%;" data-edit="img" />
                    </div>
                </div>
                {{/if}}
            </div>
        </div>

        <div class="tab details" data-tab="details">
            <div class="row-section">
                <div class="col">

                    <div class="form-group">
                        <label class="label-text">{{localize "dsk.LeP"}}- {{localize "dsk.baseValue"}}</label>
                        {{formInput systemFields.LeP value=document.system.LeP}}
                    </div>

                    <div class="form-group">
                        <label class="label-text">{{localize "dsk.soulpower"}}- {{localize "dsk.baseValue"}}</label>
                        {{formInput systemFields.sk value=document.system.sk}}
                    </div>

                    <div class="form-group">
                        <label class="label-text">{{localize "dsk.toughness"}}- {{localize "dsk.baseValue"}}</label>
                        {{formInput systemFields.zk value=document.system.zk}}
                    </div>

                    {{formGroup systemFields.gs value=document.system.gs localize=true classes="full-height"}}

                    {{formGroup systemFields.advantages value=document.system.advantages localize=true}}
                   
                </div>
            </div>
        </div>
    </section>

</form>