<form class="dsk item-sheet {{cssClass}}" autocomplete="off">
    {{> systems/dsk/templates/items/item-header.hbs}} {{> systems/dsk/templates/items/item-equipment.hbs}}

    <nav class="sheet-tabs tabs" data-tab-container="primary">
        <a class="item active" data-tab="description">{{localize "dsk.description"}}</a>
        <a class="item" data-tab="details">{{localize "dsk.details"}}</a>
        <a class="item" data-tab="effects">{{localize "dsk.statuseffects"}}</a>
    </nav>

    <section class="content">

        {{> systems/dsk/templates/items/item-description.hbs}} {{> systems/dsk/templates/items/item-effects.hbs}}
        <div class="tab details" data-tab="details">
            {{formGroup systemFields.ammunitionType value=document.system.ammunitionType localize=true}}

            {{#if (eq system.ammunitionType 'mag')}}
            <div class="form-group double">
                <label class="label-text">{{localize "dsk.ammunition.mag"}}</label>
                {{formInput systemFields.mag.fields.value value=document.system.mag.value}}
                <span> / </span>
                {{formInput systemFields.mag.fields.max value=document.system.mag.max}}
            </div>
            {{/if}}

            {{formGroup systemFields.length value=document.system.length localize=true}}
        </div>
    </section>
</form>