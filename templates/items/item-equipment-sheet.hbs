<div class="tab standard-form scrollable {{tabs.details.cssClass}}" data-tab="details" data-group="{{tabs.details.group}}">
    {{#if containerContent}}
    <div class="bagUsage">
        <div class="fillage {{weightExceeded}}" {{{weightWidth}}}></div>
        <div class="center fillText">
            {{weightSum}} / {{system.capacity}} <i class="fas fa-weight-hanging"></i>
        </div>
    </div>
    <div class="bags row-section wrap">
        {{#each containerContent as |item i|}}
        <div class="slot {{item.enchantClass}}" data-item-id="{{item.id}}" data-name="{{item.name}}" data-weight="{{item.weight}}" data-quantity="{{item.quantity}}">
            <div style="background-image:url('{{item.img}}')"></div>
        </div>
        {{/each}}
    </div>
    {{/if}}

    {{formGroup systemFields.category value=document.system.category localize=true}}
    {{formGroup systemFields.worn.fields.wearable value=document.system.worn.wearable localize=true}}

    {{#if (eq system.category 'bags')}}
    {{formGroup systemFields.capacity value=document.system.capacity localize=true}}
    {{/if}}
</div>